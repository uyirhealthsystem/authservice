# Copy to /opt/authservice/shared/authservice.env on the EC2 host and fill in.
# chmod 600, owned by the `authservice` user. NEVER commit the real file.

NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Postgres - RDS endpoint, or a local instance on the box.
DATABASE_URL="postgresql://authservice:CHANGE_ME@your-db-host:5432/authservice?schema=public"

# The refresh-token cookie is used only by the WEB portals. Set this to the
# parent domain the API and the web portals share, e.g. uyirhealthapp.com.
COOKIE_DOMAIN=uyirhealthapp.com

# --- Kafka (needed for password-reset emails) ------------------------------
# authservice publishes PasswordResetRequested to auth.events; notification-
# service turns it into the email. Leave KAFKA_BROKERS empty and the service
# still runs, but "forgot password" sends nothing (an error is logged at boot).
# Use the SAME cluster and settings as notification-service's env file.
KAFKA_BROKERS=b-1.your-cluster.kafka.ap-south-1.amazonaws.com:9096,b-2.your-cluster.kafka.ap-south-1.amazonaws.com:9096
KAFKA_CLIENT_ID=authservice
# Managed Kafka: TLS + SASL. MSK with SASL/SCRAM: port 9096, scram-sha-512.
# Plaintext broker in a private subnet: KAFKA_SSL=false and leave SASL empty.
KAFKA_SSL=true
KAFKA_SASL_MECHANISM=scram-sha-512
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Brute-force guard (defaults shown; raise the window/lower the max to taste).
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# --- Google OAuth (optional; login routes 503 until set) --------------------
# CLIENT_ID + CLIENT_SECRET come from Google Cloud Console -> Credentials ->
# the Web application OAuth client. GOOGLE_REDIRECT_URI must also be listed
# there under "Authorized redirect URIs". GOOGLE_ALLOWED_PORTAL_REDIRECT_URIS
# is the FRONTEND portal page (not an API path), exactly as the portal sends it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.uyirhealthapp.com/api/v1/auth/google/callback
GOOGLE_ALLOWED_PORTAL_REDIRECT_URIS=https://portal.uyirhealthapp.com/oauth/callback
GOOGLE_NATIVE_CLIENT_IDS=
