# Copy to /opt/authservice/shared/authservice.env on the EC2 host and fill in.
# chmod 600, owned by the `authservice` user. NEVER commit the real file.

NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Postgres - RDS endpoint, or a local instance on the box.
DATABASE_URL="postgresql://authservice:CHANGE_ME@your-db-host:5432/authservice?schema=public"

# The refresh-token cookie is used only by the WEB portals. Set this to the
# parent domain the API and the web portals share, e.g. uyirhealthapp.com.
COOKIE_DOMAIN=uyirhealthapp.com

# Brute-force guard (defaults shown; raise the window/lower the max to taste).
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# --- Google OAuth (optional; login routes 503 until set) --------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.uyirhealthapp.com/auth/google/callback
GOOGLE_ALLOWED_PORTAL_REDIRECT_URIS=https://portal.uyirhealthapp.com/oauth/callback
GOOGLE_NATIVE_CLIENT_IDS=
