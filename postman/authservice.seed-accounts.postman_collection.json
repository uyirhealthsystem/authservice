    {
      "name": "List pending seed accounts",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "// Only our own test accounts - never approve anyone else's pending signup.",
              "const ids = pm.response.json().users",
              "  .filter((u) => /@uyir\\.test$/.test(u.email))",
              "  .map((u) => u.id);",
              "pm.collectionVariables.set(\"seedPendingIds\", JSON.stringify(ids));",
              "console.log(`seed: ${ids.length} pending @uyir.test account(s) to approve`);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{seedSuperAdminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/users?status=PENDING",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "users"
          ],
          "query": [
            {
              "key": "status",
              "value": "PENDING"
            }
          ]
        }
      }
    },
    {
      "name": "Approve pending seed accounts (loops)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Takes the next id off the list; the test script re-runs this request until it is empty.",
              "const ids = JSON.parse(pm.collectionVariables.get(\"seedPendingIds\") || \"[]\");",
              "if (ids.length === 0) {",
              "  console.log(\"seed: nothing pending, skipping approve\");",
              "  pm.execution.skipRequest();",
              "} else {",
              "  pm.collectionVariables.set(\"seedApproveId\", ids.shift());",
              "  pm.collectionVariables.set(\"seedPendingIds\", JSON.stringify(ids));",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"approved\", () => pm.response.to.have.status(200));",
              "const left = JSON.parse(pm.collectionVariables.get(\"seedPendingIds\") || \"[]\");",
              "if (left.length > 0) pm.execution.setNextRequest(pm.info.requestName);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{seedSuperAdminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/users/{{seedApproveId}}/approve",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "users",
            "{{seedApproveId}}",
            "approve"
          ]
        }
      }
    }
