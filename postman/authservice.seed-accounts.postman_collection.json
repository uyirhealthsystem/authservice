    {
      "name": "Login Super Admin (seed)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"seedSuperAdminToken\", pm.response.json().accessToken);"
