    {
      "name": "Login Super Admin (seed)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Login OTP: a correct password returns 202 and emails a 6-digit code.",
              "// Put that code in the {{loginOtp}} variable, then send the next request (Verify login code).",
              "if (pm.response.code === 202) {",
              "  const ch = pm.response.json();",
              "  pm.collectionVariables.set('loginChallengeId', ch.challengeId);",
              "  pm.test('sign-in code emailed to ' + ch.email + ' - set {{loginOtp}} and run Verify', () => pm.expect(ch.otpRequired).to.eql(true));",
              "  return;",
              "}",
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"seedSuperAdminToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"superadmin@uyir.test\",\n  \"password\": \"{{seedPassword}}\",\n  \"clientId\": \"superadmin-portal\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/email/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "email",
            "login"
          ]
        }
      }
    },
    {
      "name": "↳ Verify login code (Login Super Admin (seed))",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"seedSuperAdminToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"challengeId\": \"{{loginChallengeId}}\",\n  \"otp\": \"{{loginOtp}}\",\n  \"clientId\": \"superadmin-portal\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/email/login/verify",
        "description": "Second step of email/password login. `otp` is the 6-digit code emailed after the password step (set `{{loginOtp}}`). Returns the same `200 { accessToken, role }` (+ `refreshToken` for native apps / cookie for web) the login used to return.\n\nErrors: `INVALID_LOGIN_CODE` (400, wrong code - message says attempts left; locked after 5), `LOGIN_CHALLENGE_INVALID` (400, expired / used / other portal - log in again), `ACCOUNT_DISABLED` (403), `RATE_LIMITED` (429)."
      },
      "response": []
    },
    {
      "name": "List pending seed accounts",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "// Only our own test accounts - never approve anyone else's pending signup.",
              "const ids = pm.response.json().users",
              "  .filter((u) => /@uyir\\.test$/.test(u.email))",
              "  .map((u) => u.id);",
              "pm.collectionVariables.set(\"seedPendingIds\", JSON.stringify(ids));",
              "console.log(`seed: ${ids.length} pending @uyir.test account(s) to approve`);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{seedSuperAdminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/users?status=PENDING",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "users"
          ],
          "query": [
            {
              "key": "status",
              "value": "PENDING"
            }
          ]
        }
      }
    },
    {
      "name": "Approve pending seed accounts (loops)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Takes the next id off the list; the test script re-runs this request until it is empty.",
              "const ids = JSON.parse(pm.collectionVariables.get(\"seedPendingIds\") || \"[]\");",
              "if (ids.length === 0) {",
              "  console.log(\"seed: nothing pending, skipping approve\");",
              "  pm.execution.skipRequest();",
              "} else {",
              "  pm.collectionVariables.set(\"seedApproveId\", ids.shift());",
              "  pm.collectionVariables.set(\"seedPendingIds\", JSON.stringify(ids));",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"approved\", () => pm.response.to.have.status(200));",
              "const left = JSON.parse(pm.collectionVariables.get(\"seedPendingIds\") || \"[]\");",
              "if (left.length > 0) pm.execution.setNextRequest(pm.info.requestName);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{seedSuperAdminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/users/{{seedApproveId}}/approve",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "users",
            "{{seedApproveId}}",
            "approve"
          ]
        }
      }
    }
  ]
}
