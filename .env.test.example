# Copy to .env.test for local test runs. The suite talks to a REAL Postgres
# and truncates tables between cases - point it at a throwaway database, never
# your dev one.
DATABASE_URL="postgresql://postgres:12345678@localhost:5432/authservice_test"
NODE_ENV=test
LOG_LEVEL=silent
COOKIE_DOMAIN=localhost

# Keep the brute-force limiter out of the way for the bulk of the suite.
# test/rate-limit.test.ts overrides this to a low value on its own app instance.
AUTH_RATE_LIMIT_MAX=100000
