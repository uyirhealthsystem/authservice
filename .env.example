PORT=4000
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL="postgresql://postgres:password@localhost:5432/authservice"

# httpOnly refresh-token cookie
COOKIE_DOMAIN=localhost

# Google OAuth (optional at boot - login route 503s until these are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
GOOGLE_ALLOWED_PORTAL_REDIRECT_URIS=http://localhost:5173/oauth/callback
# Native (iOS/Android) Google OAuth client IDs, comma-separated - accepted as
# the audience of an ID token on POST /auth/google/native. Only GOOGLE_CLIENT_ID
# is needed for the web redirect flow.
GOOGLE_NATIVE_CLIENT_IDS=
