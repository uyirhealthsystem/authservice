PORT=8001
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL="postgresql://authservice:authservice@localhost:5432/authservice"

# httpOnly refresh-token cookie
COOKIE_DOMAIN=localhost

# Kafka (optional at boot, like Google above). When KAFKA_BROKERS is empty the
# domain-event producer is a no-op: /api/v1/auth/password/forgot still returns 202 but
# no PasswordResetRequested event is published, so no reset code email is sent
# until Kafka + the notification service are running.
KAFKA_BROKERS=
KAFKA_CLIENT_ID=authservice
# Managed Kafka (MSK, Confluent Cloud...) - TLS and SASL. Leave empty locally.
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Login OTP - email/password login emails a 6-digit code that must be entered
# (POST /api/v1/auth/email/login/verify). Locally, with KAFKA_BROKERS empty, the
# code is printed in this service's log instead of emailed (never in production,
# where login returns 503 if the code can't be sent). LOGIN_OTP_ENABLED=false is
# the kill switch: login issues tokens right after the password, as before.
LOGIN_OTP_ENABLED=true
LOGIN_OTP_TTL_MIN=5
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_RESEND_COOLDOWN_SEC=30
LOGIN_OTP_MAX_SENDS_PER_CHALLENGE=4
LOGIN_OTP_MAX_SENDS_PER_USER=10
LOGIN_OTP_USER_WINDOW_MIN=15

# Google OAuth (optional at boot - login route 503s until these are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
GOOGLE_ALLOWED_PORTAL_REDIRECT_URIS=http://localhost:5173/oauth/callback
# Native (iOS/Android) Google OAuth client IDs, comma-separated - accepted as
# the audience of an ID token on POST /api/v1/auth/google/native. Only GOOGLE_CLIENT_ID
# is needed for the web redirect flow.
GOOGLE_NATIVE_CLIENT_IDS=
