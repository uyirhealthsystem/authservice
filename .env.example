PORT=4000
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL="postgresql://authservice:authservice@localhost:5432/authservice"

# httpOnly refresh-token cookie
COOKIE_DOMAIN=localhost

# Kafka (optional at boot, like Google above). When KAFKA_BROKERS is empty the
# domain-event producer is a no-op: /api/v1/auth/password/forgot still returns 202 but
# no PasswordResetRequested event is published, so no reset code email is sent
# until Kafka + the notification service are running.
KAFKA_BROKERS=
KAFKA_CLIENT_ID=authservice

# Google OAuth (optional at boot - login route 503s until these are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
GOOGLE_ALLOWED_PORTAL_REDIRECT_URIS=http://localhost:5173/oauth/callback
# Native (iOS/Android) Google OAuth client IDs, comma-separated - accepted as
# the audience of an ID token on POST /api/v1/auth/google/native. Only GOOGLE_CLIENT_ID
# is needed for the web redirect flow.
GOOGLE_NATIVE_CLIENT_IDS=
